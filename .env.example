# Plantilla de variables de entorno.
# Copiar a .env y completar con valores reales:  cp .env.example .env
# El .env real NUNCA se commitea (está en .gitignore). Este archivo SÍ.
# Los tipos y las reglas de validación viven en config.py.

# === ENVÍO DE MAIL ===
# Cuenta que envía el reporte. Debe ser un mail válido.
EMAIL_SENDER=
# Contraseña de aplicación de Gmail (16 caracteres, no la contraseña de la cuenta).
EMAIL_PASSWORD=
# Destinatarios del reporte, separados por coma. Al menos uno.
EMAIL_RECEIVER=alguien@dominio.com,otro@dominio.com
# Destinatarios que además reciben el CSV adjunto, separados por coma.
EMAIL_RECEIVER_CSV=alguien@dominio.com

# === CLAVES DE API ===
# Gemini: la 2 es opcional y se usa como failover cuando la 1 agota cuota (429).
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
# St. Louis FED (FRED) — https://fredaccount.stlouisfed.org/apikeys
FED_API_KEY=
# Postgres de Supabase: postgresql://usuario:password@host:5432/postgres
SUPABASE_DB_URL=

# === RUTAS DE ARCHIVOS ===
# Ruta absoluta al CSV histórico local.
RUTA_BBDD=
# Ruta absoluta a la carpeta del repo (se usa para el push de previews).
RUTA_REPO=

# === SERVICIO / DESPLIEGUE ===
# URL del endpoint que dispara la corrida.
SERVICE_ROUTE=
# Clave que protege POST /run en app.py. Opcional: si está vacía, no se exige header.
API_KEY_EASY_PANEL=
